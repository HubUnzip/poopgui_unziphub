            local ToggleBg = Create("Frame", {
                Name = "ToggleBg",
                BackgroundColor3 = toggled and theme.Toggle_On or theme.Toggle_Off,
                Size = UDim2.new(0, 46, 0, 24),
                Position = UDim2.new(1, -60, 0.5, -12),
                Parent = ToggleFrame
            })
            AddCorner(ToggleBg, 12)

            local switchGlow = AddGlow(ToggleBg, theme.Toggle_On, 12)
            switchGlow.ImageTransparency = toggled and 0.7 or 1

            local ToggleCircle = Create("Frame", {
                Name = "Circle",
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Size = UDim2.new(0, 18, 0, 18),
                Position = toggled and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
                Parent = ToggleBg
            })
            AddCorner(ToggleCircle, 9)
            AddStroke(ToggleCircle, Color3.fromRGB(0,0,0), 1, 0.7)

            local ClickArea = Create("TextButton", {
                Name = "ClickArea",
                Text = "",
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Parent = ToggleFrame
            })

            local function updateToggle(animate)
                local dur = animate ~= false and 0.3 or 0
                if toggled then
                    Tween(ToggleBg, {BackgroundColor3 = theme.Toggle_On}, dur)
                    Tween(ToggleCircle, {Position = UDim2.new(1, -21, 0.5, -9), Size = UDim2.new(0, 18, 0, 18)}, dur, Enum.EasingStyle.Back)
                    Tween(switchGlow, {ImageTransparency = 0.7, ImageColor3 = theme.Toggle_On}, dur)
                    Tween(toggleGlow, {ImageTransparency = 0.9}, dur)
                    Tween(toggleStroke, {Color = theme.Toggle_On, Transparency = 0.4}, dur)
                else
                    Tween(ToggleBg, {BackgroundColor3 = theme.Toggle_Off}, dur)
                    Tween(ToggleCircle, {Position = UDim2.new(0, 3, 0.5, -9), Size = UDim2.new(0, 18, 0, 18)}, dur, Enum.EasingStyle.Back)
                    Tween(switchGlow, {ImageTransparency = 1}, dur)
                    Tween(toggleGlow, {ImageTransparency = 1}, dur)
                    Tween(toggleStroke, {Color = theme.Divider, Transparency = 0.6}, dur)
                end
                if saveKey then PoopGUI:RegisterSetting(saveKey, toggled) end
            end

            ClickArea.MouseButton1Click:Connect(function()
                toggled = not toggled
                Tween(ToggleCircle, {Size = UDim2.new(0, 22, 0, 16)}, 0.1)
                task.delay(0.1, function() updateToggle() end)
                callback(toggled)
            end)

            ClickArea.MouseEnter:Connect(function()
                Tween(ToggleFrame, {BackgroundColor3 = Color3.fromRGB(
                    math.min(theme.TertiaryBackground.R * 255 + 8, 255) / 255,
                    math.min(theme.TertiaryBackground.G * 255 + 8, 255) / 255,
                    math.min(theme.TertiaryBackground.B * 255 + 8, 255) / 255
                )}, 0.2)
            end)
            ClickArea.MouseLeave:Connect(function()
                Tween(ToggleFrame, {BackgroundColor3 = theme.TertiaryBackground}, 0.2)
            end)

            if default then
                updateToggle(false)
                callback(default)
            end

            local toggleObj = {}
            function toggleObj:Set(value)
                toggled = value
                updateToggle()
                callback(toggled)
            end
            function toggleObj:Get()
                return toggled
            end
            return toggleObj
        end


-- Create an icon element (TextLabel for emoji, ImageLabel for asset)
local function CreateIconElement(parent, iconName, size, position, color)
    size = size or UDim2.new(0, 18, 0, 18)
    position = position or UDim2.new(0, 0, 0, 0)
    
    local isAsset = IsAssetId(iconName)
    local lucideAsset = nil
    
    if not isAsset and iconName and iconName ~= "" then
        lucideAsset = GetLucideIcon(iconName, 64)
    end
    
    if isAsset or lucideAsset then
        return Create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            Image = lucideAsset or iconName,
            ImageColor3 = color or PoopGUI._theme.TextDimmed,
            Size = size,
            Position = position,
            Parent = parent
        })
    else
        local iconText = GetIcon(iconName)
        return Create("TextLabel", {
            Name = "Icon",
            Text = iconText,
            BackgroundTransparency = 1,
            TextColor3 = color or PoopGUI._theme.TextDimmed,
            Font = Enum.Font.GothamBold,
            TextSize = math.min(size.X.Offset, size.Y.Offset),
            Size = size,
            Position = position,
            Parent = parent
        })
    end
end

local function MakeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Tween(frame, {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            }, 0.06)
        end
    end)
end

local function RippleEffect(button)
    button.ClipsDescendants = true
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local ripple = Create("Frame", {
                Name = "Ripple",
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BackgroundTransparency = 0.65,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, input.Position.X - button.AbsolutePosition.X, 0, input.Position.Y - button.AbsolutePosition.Y),
                Size = UDim2.new(0, 0, 0, 0),
                Parent = button
            })
            AddCorner(ripple, 999)
            local maxSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.5
            Tween(ripple, {Size = UDim2.new(0, maxSize, 0, maxSize), BackgroundTransparency = 1}, 0.6)
            task.delay(0.6, function() ripple:Destroy() end)
        end
    end)
end

local function PulseGlow(glowInstance, minT, maxT, speed)
    minT = minT or 0.75
    maxT = maxT or 0.95
    speed = speed or 1.5
    task.spawn(function()
        while glowInstance and glowInstance.Parent do
            Tween(glowInstance, {ImageTransparency = minT}, speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(speed)
            Tween(glowInstance, {ImageTransparency = maxT}, speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(speed)
        end
    end)
end

local function ShakeEffect(instance, intensity, duration)
    intensity = intensity or 5
    duration = duration or 0.3
    local originalPos = instance.Position
    task.spawn(function()
        local elapsed = 0
        while elapsed < duration do
            local ox = math.random(-intensity, intensity)
            local oy = math.random(-intensity, intensity)
            instance.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + ox, originalPos.Y.Scale, originalPos.Y.Offset + oy)
            task.wait(0.02)
            elapsed = elapsed + 0.02
        end
        Tween(instance, {Position = originalPos}, 0.15)
    end)
end

-- ============================================================
-- THEME MANAGEMENT
-- ============================================================
function PoopGUI:SetTheme(themeName)
    if Themes[themeName] then
        self._theme = Themes[themeName]
        self._themeName = themeName
    else
        warn("[PoopGUI] Theme '" .. tostring(themeName) .. "' not found. Available: " .. table.concat(self:GetThemeNames(), ", "))
    end
end

function PoopGUI:GetThemeNames()
    local names = {}
    for name, _ in pairs(Themes) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

function PoopGUI:AddCustomTheme(name, themeTable)
    Themes[name] = themeTable
end


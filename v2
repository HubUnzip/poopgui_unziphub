        Name = "Progress",
        BackgroundColor3 = notifColor,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
        Parent = notif
    })

    Tween(notif, {Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 0}, 0.4, Enum.EasingStyle.Back)
    task.delay(0.1, function()
        Tween(notifGlow, {ImageTransparency = 0.8}, 0.3)
        Tween(notif:FindFirstChild("Title"), {TextTransparency = 0}, 0.3)
        Tween(notif:FindFirstChild("Message"), {TextTransparency = 0}, 0.4)
        Tween(progressBar, {BackgroundTransparency = 0}, 0.3)
    end)

    task.delay(0.4, function()
        Tween(progressBar, {Size = UDim2.new(0, 0, 0, 2)}, duration - 0.4, Enum.EasingStyle.Linear)
    end)

    task.delay(duration, function()
        Tween(notifGlow, {ImageTransparency = 1}, 0.2)
        Tween(notif:FindFirstChild("Title"), {TextTransparency = 1}, 0.2)
        Tween(notif:FindFirstChild("Message"), {TextTransparency = 1}, 0.2)
        Tween(notif, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.wait(0.5)
        notif:Destroy()
    end)
end

-- ============================================================
-- SETTINGS / SAVE SYSTEM
-- ============================================================
function PoopGUI:SetSettingsFile(fileName)
    self._settingsFile = fileName or "PoopGUI_Settings.json"
end

function PoopGUI:RegisterSetting(id, value)
    self._settings[id] = value
end

function PoopGUI:GetSetting(id)
    return self._settings[id]
end

function PoopGUI:SaveSettings()
    local success, err = pcall(function()
        if writefile then
            local data = HttpService:JSONEncode(self._settings)
            writefile(self._settingsFile, data)
        end
    end)
    if success then
        self:Notify("PoopGUI", "Settings saved successfully!", 2, "Success")
    else
        self:Notify("PoopGUI", "Failed to save: " .. tostring(err), 3, "Error")
    end
    return success
end

function PoopGUI:LoadSettings()
    local success, err = pcall(function()
        if readfile and isfile and isfile(self._settingsFile) then
            local data = readfile(self._settingsFile)
            local decoded = HttpService:JSONDecode(data)
            for id, value in pairs(decoded) do
                self._settings[id] = value
            end
        end
    end)
    if success then
        self:Notify("PoopGUI", "Settings loaded!", 2, "Success")
    else
        self:Notify("PoopGUI", "Failed to load: " .. tostring(err), 3, "Error")
    end
    return success, self._settings
end


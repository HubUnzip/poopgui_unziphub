            end

            local draggingSV = false
            SatValBox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSV = true end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSV = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if draggingSV and input.UserInputType == Enum.UserInputType.MouseMovement then
                    sat = math.clamp((input.Position.X - SatValBox.AbsolutePosition.X) / SatValBox.AbsoluteSize.X, 0, 1)
                    val = 1 - math.clamp((input.Position.Y - SatValBox.AbsolutePosition.Y) / SatValBox.AbsoluteSize.Y, 0, 1)
                    updateColor()
                end
            end)

            local draggingHue = false
            HueSlider.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = true end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if draggingHue and input.UserInputType == Enum.UserInputType.MouseMovement then
                    hue = math.clamp((input.Position.Y - HueSlider.AbsolutePosition.Y) / HueSlider.AbsoluteSize.Y, 0, 1)
                    updateColor()
                end
            end)

            ColorPreview.MouseButton1Click:Connect(function()
                opened = not opened
                if opened then
                    Tween(ColorFrame, {Size = UDim2.new(1, 0, 0, 200)}, 0.35, Enum.EasingStyle.Back)
                    Tween(cpStroke, {Color = currentColor, Transparency = 0.3}, 0.2)
                    Tween(ColorPreview, {Size = UDim2.new(0, 40, 0, 28)}, 0.15, Enum.EasingStyle.Back)
                    task.delay(0.15, function()
                        Tween(ColorPreview, {Size = UDim2.new(0, 36, 0, 24)}, 0.15)
                    end)
                else
                    Tween(ColorFrame, {Size = UDim2.new(1, 0, 0, 44)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                    Tween(cpStroke, {Color = theme.Divider, Transparency = 0.6}, 0.2)
                end
            end)

            updateColor()

            local colorObj = {}
            function colorObj:Set(color) hue, sat, val = Color3.toHSV(color); updateColor() end
            function colorObj:Get() return currentColor end
            return colorObj
        end

        -- ============================================================
        -- SLIDER
        -- ============================================================
        function Tab:CreateSlider(name, description, min, max, default, callback, saveKey)
            min = min or 0
            max = max or 100
            default = default or min
            callback = callback or function() end

            if saveKey and PoopGUI._settings[saveKey] ~= nil then
                default = PoopGUI._settings[saveKey]
            end
            local value = default

            local SliderFrame = Create("Frame", {
                Name = name .. "_Slider",
                BackgroundColor3 = theme.TertiaryBackground,
                Size = UDim2.new(1, 0, 0, 54),
                Parent = TabPage
            })
            AddCorner(SliderFrame, 8)
            AddStroke(SliderFrame, theme.Divider, 1, 0.6)

            Create("TextLabel", {
                Name = "Name", Text = name,
                TextColor3 = theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
                Size = UDim2.new(0.6, 0, 0, 20), Position = UDim2.new(0, 14, 0, 5),
                Parent = SliderFrame
            })

            local ValueLabel = Create("TextLabel", {
                Name = "Value", Text = tostring(value),
                TextColor3 = theme.Accent, Font = Enum.Font.GothamBold, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right, BackgroundTransparency = 1,
                Size = UDim2.new(0.4, -14, 0, 20), Position = UDim2.new(0.6, 0, 0, 5),
                Parent = SliderFrame
            })

            local SliderTrack = Create("Frame", {
                Name = "Track", BackgroundColor3 = theme.Background,
                Size = UDim2.new(1, -28, 0, 6), Position = UDim2.new(0, 14, 0, 36),
                Parent = SliderFrame
            })
            AddCorner(SliderTrack, 3)

            local SliderFill = Create("Frame", {
                Name = "Fill", BackgroundColor3 = theme.Accent,
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                Parent = SliderTrack
            })
            AddCorner(SliderFill, 3)
            AddGlow(SliderFill, theme.Accent, 8).ImageTransparency = 0.8

            local SliderKnob = Create("Frame", {
                Name = "Knob", BackgroundColor3 = Color3.fromRGB(255,255,255),
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new((value - min) / (max - min), -8, 0.5, -8),
                Parent = SliderTrack
            })
            AddCorner(SliderKnob, 8)
            AddStroke(SliderKnob, theme.Accent, 2, 0)

            local dragging = false
            local SliderInput = Create("TextButton", {
                Name = "Input", Text = "", BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, 28),
                Parent = SliderFrame
            })

            local function updateSlider(inputPos)
                local relX = math.clamp((inputPos - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * relX)
                ValueLabel.Text = tostring(value)
                Tween(SliderFill, {Size = UDim2.new(relX, 0, 1, 0)}, 0.05)
                Tween(SliderKnob, {Position = UDim2.new(relX, -8, 0.5, -8)}, 0.05)
                if saveKey then PoopGUI:RegisterSetting(saveKey, value) end
                callback(value)
            end

            SliderInput.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    Tween(SliderKnob, {Size = UDim2.new(0, 20, 0, 20)}, 0.15, Enum.EasingStyle.Back)
                    updateSlider(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    Tween(SliderKnob, {Size = UDim2.new(0, 16, 0, 16)}, 0.2, Enum.EasingStyle.Back)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateSlider(input.Position.X)
                end
            end)

            local sliderObj = {}
            function sliderObj:Set(v)
                value = math.clamp(v, min, max)
                local relX = (value - min) / (max - min)
                ValueLabel.Text = tostring(value)
                SliderFill.Size = UDim2.new(relX, 0, 1, 0)
                SliderKnob.Position = UDim2.new(relX, -8, 0.5, -8)
                callback(value)
            end
            function sliderObj:Get() return value end
            return sliderObj
        end

        -- ============================================================
        -- TEXT INPUT
        -- ============================================================
        function Tab:CreateInput(name, description, placeholder, callback, saveKey)
            placeholder = placeholder or "Enter text..."
            callback = callback or function() end

            local InputFrame = Create("Frame", {
                Name = name .. "_Input",
                BackgroundColor3 = theme.TertiaryBackground,
                Size = UDim2.new(1, 0, 0, 44),
                Parent = TabPage
            })
            AddCorner(InputFrame, 8)
            local inputStroke = AddStroke(InputFrame, theme.Divider, 1, 0.6)

            Create("TextLabel", {
                Name = "Name", Text = name,
                TextColor3 = theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
                Size = UDim2.new(0.45, 0, 1, 0), Position = UDim2.new(0, 14, 0, 0),
                Parent = InputFrame
            })

            local TextBox = Create("TextBox", {
                Name = "TextBox",
                Text = (saveKey and PoopGUI._settings[saveKey]) or "",
                PlaceholderText = placeholder,
                PlaceholderColor3 = theme.TextMuted,
                TextColor3 = theme.Text,
                Font = Enum.Font.Gotham, TextSize = 12,
                BackgroundColor3 = theme.Background,
                Size = UDim2.new(0.5, -14, 0, 28),
                Position = UDim2.new(0.5, 0, 0.5, -14),
                ClearTextOnFocus = false,
                Parent = InputFrame
            })
            AddCorner(TextBox, 6)
            AddPadding(TextBox, 0, 8, 0, 8)

            TextBox.Focused:Connect(function()
                Tween(inputStroke, {Color = theme.Accent, Transparency = 0.2}, 0.2)
            end)
            TextBox.FocusLost:Connect(function()
                Tween(inputStroke, {Color = theme.Divider, Transparency = 0.6}, 0.2)
                if saveKey then PoopGUI:RegisterSetting(saveKey, TextBox.Text) end
                callback(TextBox.Text)
            end)

            local inputObj = {}
            function inputObj:Set(text) TextBox.Text = text; callback(text) end
            function inputObj:Get() return TextBox.Text end
            return inputObj
        end

        -- ============================================================
        -- KEYBIND
        -- ============================================================
        function Tab:CreateKeybind(name, description, default, callback, saveKey)
            default = default or Enum.KeyCode.F
            callback = callback or function() end
            local currentKey = default
            local listening = false

            local KeybindFrame = Create("Frame", {
                Name = name .. "_Keybind",
                BackgroundColor3 = theme.TertiaryBackground,
                Size = UDim2.new(1, 0, 0, 44),
                Parent = TabPage
            })
            AddCorner(KeybindFrame, 8)
            AddStroke(KeybindFrame, theme.Divider, 1, 0.6)

            Create("TextLabel", {
                Name = "Name", Text = name,
                TextColor3 = theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
                Size = UDim2.new(1, -100, 1, 0), Position = UDim2.new(0, 14, 0, 0),
                Parent = KeybindFrame
            })

            local KeyBtn = Create("TextButton", {
                Name = "Key", Text = tostring(currentKey.Name),
                TextColor3 = theme.Accent, Font = Enum.Font.GothamBold, TextSize = 12,
                BackgroundColor3 = theme.Background,
                Size = UDim2.new(0, 72, 0, 28), Position = UDim2.new(1, -84, 0.5, -14),
                AutoButtonColor = false, Parent = KeybindFrame
            })
            AddCorner(KeyBtn, 6)

            KeyBtn.MouseButton1Click:Connect(function()
                listening = true
                KeyBtn.Text = "..."
                Tween(KeyBtn, {BackgroundColor3 = theme.Accent, Size = UDim2.new(0, 76, 0, 30)}, 0.2, Enum.EasingStyle.Back)
                Tween(KeyBtn, {TextColor3 = Color3.fromRGB(255,255,255)}, 0.2)
            end)

            UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    KeyBtn.Text = currentKey.Name
                    listening = false
                    Tween(KeyBtn, {BackgroundColor3 = theme.Background, Size = UDim2.new(0, 72, 0, 28)}, 0.2, Enum.EasingStyle.Back)
                    Tween(KeyBtn, {TextColor3 = theme.Accent}, 0.2)
                    if saveKey then PoopGUI:RegisterSetting(saveKey, currentKey.Name) end
                elseif not listening and not gameProcessed and input.KeyCode == currentKey then
                    callback(currentKey)
                end
            end)

            local keybindObj = {}
            function keybindObj:Set(key) currentKey = key; KeyBtn.Text = key.Name end
            function keybindObj:Get() return currentKey end
            return keybindObj
        end

        return Tab
    end

    -- Select tab with slide animation
    function Window:_selectTab(tabData)
        for _, tab in ipairs(self._tabs) do
            tab.Page.Visible = false
            Tween(tab.Button, {BackgroundTransparency = 1}, 0.2)
            Tween(tab.Label, {TextColor3 = theme.TextDimmed}, 0.2)
            Tween(tab.Indicator, {Size = UDim2.new(0, 3, 0, 0)}, 0.2)
            Tween(tab.Glow, {ImageTransparency = 1}, 0.2)
            if tab.Icon then
                if tab.Icon:IsA("ImageLabel") then
                    Tween(tab.Icon, {ImageColor3 = theme.TextDimmed}, 0.2)
                end
            end
        end

        tabData.Page.Visible = true
        tabData.Page.CanvasPosition = Vector2.new(0, 0)
        tabData.Page.Position = UDim2.new(0.05, 0, 0, 0)
        Tween(tabData.Page, {Position = UDim2.new(0, 0, 0, 0)}, 0.35, Enum.EasingStyle.Quint)

        for _, child in ipairs(tabData.Page:GetChildren()) do
            if child:IsA("Frame") then
                child.BackgroundTransparency = 1
                Tween(child, {BackgroundTransparency = 0}, 0.3)
            end
        end

        Tween(tabData.Button, {BackgroundTransparency = 0.5}, 0.2)
        Tween(tabData.Label, {TextColor3 = theme.Text}, 0.2)
        Tween(tabData.Indicator, {Size = UDim2.new(0, 3, 0, 22)}, 0.35, Enum.EasingStyle.Back)
        Tween(tabData.Glow, {ImageTransparency = 0.88}, 0.2)
        if tabData.Icon then
            if tabData.Icon:IsA("ImageLabel") then
                Tween(tabData.Icon, {ImageColor3 = theme.Accent}, 0.2)
            end
        end

        self._activeTab = tabData
    end

    -- Toggle visibility with RightShift
    local guiVisible = true
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
            guiVisible = not guiVisible
            if guiVisible then
                MainFrame.Visible = true
                MainFrame.Size = UDim2.new(0, 300, 0, 210)
                MainFrame.BackgroundTransparency = 0.5
                MainFrame.Rotation = -3
                Tween(MainFrame, {Size = UDim2.new(0,600,0,420), BackgroundTransparency = 0, Rotation = 0}, 0.5, Enum.EasingStyle.Back)
            else
                Tween(MainFrame, {Size = UDim2.new(0,300,0,210), BackgroundTransparency = 0.5, Rotation = 3}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                task.delay(0.35, function() MainFrame.Visible = false end)
            end
        end
    end)

    setmetatable(Window, {__index = PoopGUI})
    table.insert(self._windows, Window)

    return Window
end

-- ============================================================
-- DESTROY
-- ============================================================
function PoopGUI:Destroy()
    for _, gui in ipairs(CoreGui:GetChildren()) do
        if gui.Name:find("PoopGUI") then gui:Destroy() end
    end
    self._windows = {}
    self._settings = {}
end

return PoopGUI

                Name = "Selected",
                Text = tostring(selected),
                TextColor3 = theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                BackgroundColor3 = theme.Background,
                Size = UDim2.new(0, 145, 0, 28),
                Position = UDim2.new(1, -180, 0, 8),
                AutoButtonColor = false,
                Parent = DropdownFrame
            })
            AddCorner(SelectedBtn, 6)

            local OptionsHolder = Create("Frame", {
                Name = "Options",
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -20, 0, 0),
                Position = UDim2.new(0, 10, 0, 48),
                Parent = DropdownFrame
            })
            Create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 3),
                Parent = OptionsHolder
            })

            local optionButtons = {}

            local function closeDropdown()
                opened = false
                Tween(Arrow, {Rotation = 0}, 0.3, Enum.EasingStyle.Back)
                Tween(DropdownFrame, {Size = UDim2.new(1, 0, 0, 44)}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                Tween(ddGlow, {ImageTransparency = 1}, 0.2)
                Tween(ddStroke, {Color = theme.Divider, Transparency = 0.6}, 0.2)
            end

            local function selectOption(optionText)
                selected = optionText
                SelectedBtn.Text = optionText
                closeDropdown()
                if saveKey then PoopGUI:RegisterSetting(saveKey, selected) end
                callback(selected)
            end

            local function createOption(optionText)
                local OptionBtn = Create("TextButton", {
                    Name = optionText,
                    Text = "  " .. optionText,
                    TextColor3 = theme.TextDimmed,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundColor3 = theme.Background,
                    BackgroundTransparency = 0.3,
                    Size = UDim2.new(1, 0, 0, 32),
                    AutoButtonColor = false,
                    Parent = OptionsHolder
                })
                AddCorner(OptionBtn, 6)

                local optionIndicator = Create("Frame", {
                    Name = "HoverBar",
                    BackgroundColor3 = theme.Accent,
                    Size = UDim2.new(0, 0, 0.6, 0),
                    Position = UDim2.new(0, 0, 0.2, 0),
                    BorderSizePixel = 0,
                    Parent = OptionBtn
                })
                AddCorner(optionIndicator, 2)

                OptionBtn.MouseEnter:Connect(function()
                    Tween(OptionBtn, {BackgroundTransparency = 0, TextColor3 = theme.Text}, 0.15)
                    Tween(optionIndicator, {Size = UDim2.new(0, 3, 0.6, 0)}, 0.2, Enum.EasingStyle.Back)
                end)
                OptionBtn.MouseLeave:Connect(function()
                    Tween(OptionBtn, {BackgroundTransparency = 0.3, TextColor3 = theme.TextDimmed}, 0.15)
                    Tween(optionIndicator, {Size = UDim2.new(0, 0, 0.6, 0)}, 0.15)
                end)

                OptionBtn.MouseButton1Click:Connect(function()
                    selectOption(optionText)
                end)

                table.insert(optionButtons, OptionBtn)
                return OptionBtn
            end

            for _, option in ipairs(options) do
                createOption(option)
            end

            SelectedBtn.MouseButton1Click:Connect(function()
                opened = not opened
                if opened then
                    local totalHeight = 44 + 8 + (#options * 35)
                    Tween(Arrow, {Rotation = 180}, 0.3, Enum.EasingStyle.Back)
                    Tween(DropdownFrame, {Size = UDim2.new(1, 0, 0, totalHeight)}, 0.35, Enum.EasingStyle.Back)
                    Tween(ddGlow, {ImageTransparency = 0.9}, 0.2)
                    Tween(ddStroke, {Color = theme.Accent, Transparency = 0.3}, 0.2)
                else
                    closeDropdown()
                end
            end)

            local dropdownObj = {}
            function dropdownObj:Set(value)
                selectOption(value)
            end
            function dropdownObj:SetByIndex(index)
                if options[index] then
                    selectOption(options[index])
                end
            end
            function dropdownObj:Get()
                return selected
            end
            function dropdownObj:GetIndex()
                for i, opt in ipairs(options) do
                    if opt == selected then return i end
                end
                return nil
            end
            function dropdownObj:Refresh(newOptions, newDefault)
                for _, btn in ipairs(optionButtons) do btn:Destroy() end
                optionButtons = {}
                options = newOptions
                for _, option in ipairs(newOptions) do createOption(option) end
                if newDefault then
                    selected = newDefault
                    SelectedBtn.Text = newDefault
                end
            end
            function dropdownObj:AddOption(optionText)
                table.insert(options, optionText)
                createOption(optionText)
            end
            function dropdownObj:RemoveOption(optionText)
                for i, opt in ipairs(options) do
                    if opt == optionText then
                        table.remove(options, i)
                        break
                    end
                end
                for i, btn in ipairs(optionButtons) do
                    if btn.Name == optionText then
                        btn:Destroy()
                        table.remove(optionButtons, i)
                        break
                    end
                end
            end

            return dropdownObj
        end

